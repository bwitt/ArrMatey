<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Instances are user-supplied LAN hosts, commonly plain HTTP or fronted by a privately installed CA. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>

    <!-- Public endpoints are always reachable over TLS, so they opt out of the relaxed base config. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tmdb.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials in the database are encrypted with an Android Keystore key, which is never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="arrmatey_room.db" />
        <exclude domain="database" path="arrmatey_room.db-wal" />
        <exclude domain="database" path="arrmatey_room.db-shm" />
        <exclude domain="database" path="arrmatey_room.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="arrmatey_room.db" />
        <exclude domain="database" path="arrmatey_room.db-wal" />
        <exclude domain="database" path="arrmatey_room.db-shm" />
        <exclude domain="database" path="arrmatey_room.db-journal" />
    </device-transfer>
</data-extraction-rules>
